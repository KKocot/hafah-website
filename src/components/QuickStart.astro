---
/**
 * QuickStart section — three Docker deployment steps.
 * Scroll-triggered staggered fade-in animations via Intersection Observer.
 */

const steps = [
  {
    number: '01',
    title: 'Pull the Docker image',
    code: 'docker pull registry.gitlab.syncad.com/hive/hafah:latest',
  },
  {
    number: '02',
    title: 'Install the database schema',
    code: `docker run --rm \\
  --env HAF_DB_URL=postgresql://<user>:<password>@<host>:5432/haf \\
  registry.gitlab.syncad.com/hive/hafah:latest \\
  install_app`,
  },
  {
    number: '03',
    title: 'Start the API server',
    code: `docker run -d \\
  --env HAF_DB_URL=postgresql://<user>:<password>@<host>:5432/haf \\
  -p 3000:3000 \\
  registry.gitlab.syncad.com/hive/hafah:latest`,
  },
];
---

<section id="quick-start" class="qs">
  <div class="qs__inner">
    <!-- Header -->
    <div class="qs__header">
      <h2 class="qs__title qs-anim">Up and Running in Minutes</h2>
      <p class="qs__subtitle qs-anim">
        Three steps to deploy your own Hive account history API
      </p>
    </div>

    <!-- Steps -->
    <div class="qs__steps">
      {steps.map((step) => (
        <article class="qs__step qs-anim">
          <span class="qs__number" aria-hidden="true">{step.number}</span>
          <div class="qs__body">
            <h3 class="qs__step-title">{step.title}</h3>
            <div class="qs__code-wrap">
              <button class="qs__copy-btn" data-code={step.code} aria-label="Copy code" type="button">
                <svg class="qs__copy-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <rect x="5.5" y="5.5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M10.5 5.5V3a1.5 1.5 0 0 0-1.5-1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h2.5" stroke="currentColor" stroke-width="1.3"/>
                </svg>
                <svg class="qs__check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8.5l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <pre class="qs__code"><code>{step.code}</code></pre>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Badge -->
    <div class="qs__badge-row qs-anim">
      <span class="qs__badge">
        Requires a running HAF database
      </span>
      <a
        href="https://gitlab.syncad.com/hive/haf"
        class="qs__badge-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        Learn more about HAF &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  function initQuickStartObserver() {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const targets = document.querySelectorAll('.qs-anim');

    if (prefersReduced) {
      targets.forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('qs-anim--visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    targets.forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = `${i * 100}ms`;
      observer.observe(el);
    });
  }

  function initCopyButtons() {
    document.querySelectorAll('.qs__copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const code = (btn as HTMLButtonElement).dataset.code;
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);
          btn.classList.add('qs__copy-btn--copied');
          setTimeout(() => {
            btn.classList.remove('qs__copy-btn--copied');
          }, 2000);
        } catch {
          // Fallback for older browsers / insecure contexts
          const textarea = document.createElement('textarea');
          textarea.value = code;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
          btn.classList.add('qs__copy-btn--copied');
          setTimeout(() => {
            btn.classList.remove('qs__copy-btn--copied');
          }, 2000);
        }
      });
    });
  }

  // Run on initial load and on Astro view-transition navigations
  initQuickStartObserver();
  initCopyButtons();
  document.addEventListener('astro:after-swap', () => {
    initQuickStartObserver();
    initCopyButtons();
  });
</script>

<style>
  /* -------------------------------------------------- */
  /*  Animation                                          */
  /* -------------------------------------------------- */
  .qs-anim {
    opacity: 0;
    transform: translateY(1.875rem); /* 30px */
    transition: opacity 500ms ease-out, transform 500ms ease-out;
  }

  .qs-anim--visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* -------------------------------------------------- */
  /*  Section                                            */
  /* -------------------------------------------------- */
  .qs {
    background-color: var(--color-bg-primary);
    padding: 6rem 1.5rem; /* 96px 24px */
  }

  .qs__inner {
    max-width: 50rem; /* 800px */
    margin: 0 auto;
  }

  /* -------------------------------------------------- */
  /*  Header                                             */
  /* -------------------------------------------------- */
  .qs__header {
    text-align: center;
    margin-bottom: 3.5rem; /* 56px */
  }

  .qs__title {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: clamp(1.75rem, 3vw + 0.5rem, 3rem); /* 28-48px */
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-text-primary);
  }

  .qs__subtitle {
    margin-top: 1rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: clamp(0.9375rem, 1vw + 0.5rem, 1.0625rem); /* 15-17px */
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 31.25rem; /* 500px */
    margin-left: auto;
    margin-right: auto;
  }

  /* -------------------------------------------------- */
  /*  Steps container                                    */
  /* -------------------------------------------------- */
  .qs__steps {
    display: flex;
    flex-direction: column;
    gap: 1.5rem; /* 24px */
  }

  /* -------------------------------------------------- */
  /*  Step card                                          */
  /* -------------------------------------------------- */
  .qs__step {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.5rem; /* 24px */
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.75rem; /* 12px */
    padding: 2rem; /* 32px */
    overflow: hidden;
  }

  /* -------------------------------------------------- */
  /*  Step number                                        */
  /* -------------------------------------------------- */
  .qs__number {
    flex-shrink: 0;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 3rem; /* 48px */
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.3;
    user-select: none;
  }

  /* -------------------------------------------------- */
  /*  Step body                                          */
  /* -------------------------------------------------- */
  .qs__body {
    flex: 1;
    min-width: 0; /* allow shrinking for overflow-x on code */
  }

  .qs__step-title {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 1.25rem; /* 20px */
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem; /* 12px */
    line-height: 1.3;
  }

  /* -------------------------------------------------- */
  /*  Code block                                         */
  /* -------------------------------------------------- */
  .qs__code-wrap {
    position: relative;
    overflow-x: auto;
    max-width: 100%;
    border-radius: 0.5rem; /* 8px */
    border: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-card);
  }

  .qs__code {
    display: block;
    padding: 1rem 1.25rem; /* 16px 20px */
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.875rem; /* 14px */
    line-height: 1.6;
    color: var(--color-text-primary);
    white-space: pre;
    margin: 0;
  }

  .qs__code code {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
  }

  /* -------------------------------------------------- */
  /*  Copy button                                        */
  /* -------------------------------------------------- */
  .qs__copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.375rem;
    color: var(--color-text-tertiary);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .qs__copy-btn:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: var(--color-text-primary);
  }

  .qs__copy-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .qs__check-icon {
    display: none;
  }

  .qs__copy-btn--copied .qs__copy-icon {
    display: none;
  }

  .qs__copy-btn--copied .qs__check-icon {
    display: block;
    color: #22c55e;
  }

  /* -------------------------------------------------- */
  /*  Badge row                                          */
  /* -------------------------------------------------- */
  .qs__badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem; /* 12px */
    margin-top: 2.5rem; /* 40px */
  }

  .qs__badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.8125rem; /* 13px */
    color: var(--color-text-tertiary);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 9999px;
    line-height: 1.4;
    user-select: none;
  }

  .qs__badge-link {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.8125rem; /* 13px */
    color: var(--color-accent);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .qs__badge-link:hover {
    color: var(--color-accent-hover);
  }

  .qs__badge-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  /* -------------------------------------------------- */
  /*  Responsive — mobile                                */
  /* -------------------------------------------------- */
  @media (max-width: 640px) {
    .qs {
      padding: 4rem 1.25rem;
    }

    .qs__header {
      margin-bottom: 2.5rem;
    }

    .qs__step {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.5rem;
    }

    .qs__number {
      font-size: 2.25rem; /* 36px */
    }

  }
</style>
