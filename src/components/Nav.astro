---
const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'API', href: '#api' },
  { label: 'Quick Start', href: '#quick-start' },
];

const gitlabUrl = 'https://gitlab.syncad.com/hive/hafah';
---

<nav
  class="sticky top-0 z-50 border-b border-border-subtle backdrop-blur-md bg-bg-primary/80"
  aria-label="Main navigation"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a
      href="/"
      class="font-mono text-xl font-bold text-text-primary transition-colors duration-200 hover:text-accent focus:outline-2 focus:outline-offset-2 focus:outline-accent"
    >
      HAfAH
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-text-secondary transition-colors duration-200 hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={gitlabUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-border-medium px-4 py-2 text-sm text-text-secondary transition-all duration-200 hover:border-accent hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent"
      >
        GitLab
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex size-10 items-center justify-center rounded-lg text-text-secondary transition-colors duration-200 hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <svg
        id="hamburger-icon"
        class="size-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg
        id="close-icon"
        class="hidden size-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu dropdown -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border-subtle md:hidden"
  >
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link rounded-lg px-3 py-2.5 text-sm text-text-secondary transition-colors duration-200 hover:bg-bg-card hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={gitlabUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link mt-2 rounded-lg border border-border-medium px-3 py-2.5 text-center text-sm text-text-secondary transition-all duration-200 hover:border-accent hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent"
      >
        GitLab
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggle && menu && hamburgerIcon && closeIcon) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden');
      // toggle returns true if 'hidden' was added (menu is now closed)
      const expanded = !isOpen;
      toggle.setAttribute('aria-expanded', String(expanded));
      hamburgerIcon.classList.toggle('hidden', expanded);
      closeIcon.classList.toggle('hidden', !expanded);
    });

    // Close menu when clicking a nav link (anchor navigation)
    const mobileLinks = menu.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
