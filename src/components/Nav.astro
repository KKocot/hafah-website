---
const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'API', href: '#api' },
  { label: 'Quick Start', href: '#quick-start' },
];

const gitlabUrl = 'https://gitlab.syncad.com/hive/hafah';
---

<nav
  class="sticky top-0 z-50 border-b border-border-subtle backdrop-blur-md bg-bg-primary/80"
  aria-label="Main navigation"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a
      href="/"
      class="font-mono text-xl font-bold text-text-primary transition-colors duration-200 hover:text-accent focus:outline-2 focus:outline-offset-2 focus:outline-accent"
    >
      HAfAH
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-section={link.href.replace('#', '')}
            class="nav-link border-b-2 border-transparent text-sm text-text-secondary transition-colors duration-200 hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={gitlabUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitLab"
        class="rounded-lg border border-border-medium px-4 py-2 text-sm text-text-secondary transition-all duration-200 hover:border-accent hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent"
      >
        <svg class="size-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 30.4L21.3 14.1H10.7L16 30.4Z"/><path d="M16 30.4L10.7 14.1H2.4L16 30.4Z" opacity="0.7"/><path d="M2.4 14.1L0.5 20.1C0.3 20.7 0.5 21.4 1 21.8L16 30.4L2.4 14.1Z" opacity="0.5"/><path d="M2.4 14.1H10.7L7.4 3.9C7.2 3.3 6.4 3.3 6.2 3.9L2.4 14.1Z"/><path d="M16 30.4L21.3 14.1H29.6L16 30.4Z" opacity="0.7"/><path d="M29.6 14.1L31.5 20.1C31.7 20.7 31.5 21.4 31 21.8L16 30.4L29.6 14.1Z" opacity="0.5"/><path d="M29.6 14.1H21.3L24.6 3.9C24.8 3.3 25.6 3.3 25.8 3.9L29.6 14.1Z"/></svg>
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex size-10 items-center justify-center rounded-lg text-text-secondary transition-colors duration-200 hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <svg
        id="hamburger-icon"
        class="size-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg
        id="close-icon"
        class="hidden size-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu dropdown -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border-subtle md:hidden"
  >
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-section={link.href.replace('#', '')}
            class="mobile-nav-link nav-link rounded-lg px-3 py-2.5 text-sm text-text-secondary transition-colors duration-200 hover:bg-bg-card hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={gitlabUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitLab"
        class="mobile-nav-link mt-2 flex items-center justify-center gap-2 rounded-lg border border-border-medium px-3 py-2.5 text-sm text-text-secondary transition-all duration-200 hover:border-accent hover:text-text-primary focus:outline-2 focus:outline-offset-2 focus:outline-accent"
      >
        <svg class="size-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 30.4L21.3 14.1H10.7L16 30.4Z"/><path d="M16 30.4L10.7 14.1H2.4L16 30.4Z" opacity="0.7"/><path d="M2.4 14.1L0.5 20.1C0.3 20.7 0.5 21.4 1 21.8L16 30.4L2.4 14.1Z" opacity="0.5"/><path d="M2.4 14.1H10.7L7.4 3.9C7.2 3.3 6.4 3.3 6.2 3.9L2.4 14.1Z"/><path d="M16 30.4L21.3 14.1H29.6L16 30.4Z" opacity="0.7"/><path d="M29.6 14.1L31.5 20.1C31.7 20.7 31.5 21.4 31 21.8L16 30.4L29.6 14.1Z" opacity="0.5"/><path d="M29.6 14.1H21.3L24.6 3.9C24.8 3.3 25.6 3.3 25.8 3.9L29.6 14.1Z"/></svg>
        GitLab
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggle && menu && hamburgerIcon && closeIcon) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden');
      // toggle returns true if 'hidden' was added (menu is now closed)
      const expanded = !isOpen;
      toggle.setAttribute('aria-expanded', String(expanded));
      hamburgerIcon.classList.toggle('hidden', expanded);
      closeIcon.classList.toggle('hidden', !expanded);
    });

    // Close menu when clicking a nav link (anchor navigation)
    const mobileLinks = menu.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }

  // Active section highlighting via IntersectionObserver
  const nav = document.querySelector('nav');
  const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('a.nav-link[data-section]');
  const sectionIds = ['features', 'architecture', 'api', 'quick-start'];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const ACTIVE_CLASSES = ['text-accent', 'border-accent'];
  const INACTIVE_CLASSES = ['text-text-secondary', 'border-transparent'];

  function setActiveSection(sectionId: string) {
    allNavLinks.forEach((link) => {
      const isMatch = link.dataset.section === sectionId;
      if (isMatch) {
        link.classList.remove(...INACTIVE_CLASSES);
        link.classList.add(...ACTIVE_CLASSES);
      } else {
        link.classList.remove(...ACTIVE_CLASSES);
        link.classList.add(...INACTIVE_CLASSES);
      }
    });
  }

  function clearActiveSection() {
    allNavLinks.forEach((link) => {
      link.classList.remove(...ACTIVE_CLASSES);
      link.classList.add(...INACTIVE_CLASSES);
    });
  }

  if (nav && sections.length > 0) {
    const navHeight = nav.offsetHeight;

    const observer = new IntersectionObserver(
      (entries) => {
        // Find the topmost currently-intersecting section
        const visibleEntries = entries.filter((e) => e.isIntersecting);
        if (visibleEntries.length > 0) {
          // Pick the one closest to the top of the viewport
          const topmost = visibleEntries.reduce((a, b) =>
            a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
          );
          setActiveSection(topmost.target.id);
        } else {
          // Check if any observed section is still in view (entries only has changed ones)
          const anyVisible = sections.some((section) => {
            const rect = section.getBoundingClientRect();
            return rect.top < window.innerHeight * 0.6 && rect.bottom > navHeight;
          });
          if (!anyVisible) {
            clearActiveSection();
          }
        }
      },
      {
        rootMargin: `-${navHeight}px 0px -40% 0px`,
        threshold: 0,
      },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
