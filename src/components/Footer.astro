---
---

<footer class="tmux-status" role="contentinfo">
  <div class="tmux-status__bar">
    <span class="tmux-status__segment"
      ><a
        href="https://gitlab.syncad.com/hive/hafah"
        class="tmux-status__link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="hafah — repository on GitLab"
        >[hafah]</a
      ></span
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://opensource.org/licenses/MIT"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="MIT License — opens in new tab"
      >MIT License</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://hive.io"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="Hive blockchain ecosystem — opens in new tab"
      >Hive</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://tools.openhive.network/haf"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="HAF — opens in new tab"
      >HAF</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://blockchainwares.com.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="Blockchain Wares — opens in new tab"
      >Blockchain Wares</a
    >
  </div>
</footer>

<style>
  .tmux-status {
    background: var(--color-bg-primary);
    border-top: 1px solid var(--color-border-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
    line-height: 1;
  }

  .tmux-status__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: 0.5rem 1rem;
    min-height: 2rem;
  }

  .tmux-status__segment {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .tmux-status__sep {
    color: var(--color-border-subtle);
    padding-inline: 0.5rem;
    user-select: none;
  }

  .tmux-status__link {
    color: var(--color-text-tertiary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease-out;
  }

  .tmux-status__link:hover,
  .tmux-status__link:focus-visible {
    color: var(--color-accent);
  }

  .tmux-status__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 40rem) {
    .tmux-status__bar {
      padding: 0.5rem 0.75rem;
      justify-content: center;
      gap: 0.25rem;
    }
  }
</style>
