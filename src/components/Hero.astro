---
---

<section class="hero">
  <div class="hero__head-block" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__content">
    <span class="hero__badge anim anim--0">
      OPEN SOURCE &middot; MIT LICENSE
    </span>

    <h1 class="hero__title anim anim--1">
      Hive Account History&nbsp;API
    </h1>

    <p class="hero__subtitle anim anim--2">
      Pure SQL. Zero Middleware. Production-Grade.
    </p>

    <p class="hero__description anim anim--3">
      Deploy a full Hive account history node in minutes.
      Two APIs (JSON-RPC + REST), one deployment, no replay required.
    </p>

    <div class="hero__cta anim anim--4">
      <a href="#quick-start" class="hero__btn hero__btn--primary">
        Quick Start
      </a>
      <a
        href="https://gitlab.syncad.com/hive/hafah/-/blob/develop/README.md"
        class="hero__btn hero__btn--secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        API Documentation
      </a>
    </div>
  </div>
</section>

<style>
  /* -------------------------------------------------- */
  /*  Keyframes                                          */
  /* -------------------------------------------------- */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes headBlockPulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.3;
      box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.15);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.3);
      opacity: 0.6;
      box-shadow: 0 0 12px 4px rgba(245, 158, 11, 0.1);
    }
  }

  @keyframes shimmer {
    0%, 100% { transform: translateX(-100%); }
    50% { transform: translateX(100%); }
  }

  @keyframes titleGradient {
    0% { background-position: 0% center; }
    50% { background-position: 100% center; }
    100% { background-position: 0% center; }
  }

  /* -------------------------------------------------- */
  /*  Animation helpers                                  */
  /* -------------------------------------------------- */
  .anim {
    opacity: 0;
    animation: fadeInUp 500ms ease-out forwards;
  }
  .anim--0 { animation-delay: 0ms; }
  .anim--1 { animation-delay: 100ms; }
  .anim--2 { animation-delay: 200ms; }
  .anim--3 { animation-delay: 300ms; }
  .anim--4 { animation-delay: 400ms; }

  /* -------------------------------------------------- */
  /*  Section                                            */
  /* -------------------------------------------------- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 6rem 1.5rem;
    overflow: hidden;
  }

  /* Warstwa 1: Pionowa linia timeline + poziome branches przechodzace przez viewport */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      /* Pionowa linia timeline */
      linear-gradient(to bottom, transparent 0%, rgba(245, 158, 11, 0.3) 10%, rgba(245, 158, 11, 0.3) 90%, transparent 100%)
        15% 0 / 2px 100% no-repeat,

      /* Dluga branch 1 */
      linear-gradient(to right, transparent 0%, rgba(245, 158, 11, 0.25) 15%, rgba(245, 158, 11, 0.15) 50%, transparent 85%)
        0 8% / 100% 2px no-repeat,

      /* Dluga branch 2 */
      linear-gradient(to right, transparent 0%, rgba(245, 158, 11, 0.3) 15%, rgba(245, 158, 11, 0.2) 60%, transparent 90%)
        0 34% / 100% 2px no-repeat,

      /* Krotsza branch 2b */
      linear-gradient(to right, transparent 0%, rgba(245, 158, 11, 0.2) 15%, rgba(245, 158, 11, 0.12) 40%, transparent 55%)
        0 37% / 100% 2px no-repeat,

      /* Dluga branch 3 */
      linear-gradient(to right, transparent 0%, rgba(245, 158, 11, 0.25) 15%, rgba(245, 158, 11, 0.15) 55%, transparent 80%)
        0 60% / 100% 2px no-repeat,

      /* Dluga branch 4 — head block, najjasniejsza */
      linear-gradient(to right, transparent 0%, rgba(245, 158, 11, 0.35) 15%, rgba(245, 158, 11, 0.25) 65%, transparent 95%)
        0 92% / 100% 3px no-repeat;

    pointer-events: none;
  }

  /* Warstwa 2: Block nodes */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      /* Node 1 */
      radial-gradient(circle 8px at 15% 8%, rgba(245, 158, 11, 0.5) 40%, transparent 60%),
      /* Node 2 */
      radial-gradient(circle 8px at 15% 34%, rgba(245, 158, 11, 0.5) 40%, transparent 60%),
      /* Node 3 */
      radial-gradient(circle 8px at 15% 60%, rgba(245, 158, 11, 0.5) 40%, transparent 60%),
      /* Node 4 — HEAD BLOCK */
      radial-gradient(circle 12px at 15% 92%, rgba(245, 158, 11, 0.7) 40%, transparent 60%);

    pointer-events: none;
  }

  /* -------------------------------------------------- */
  /*  Pulsujacy head block                               */
  /* -------------------------------------------------- */
  .hero__head-block {
    position: absolute;
    left: 15%;
    top: 92%;
    width: 16px;
    height: 16px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(245, 158, 11, 0.2);
    z-index: 0;
    pointer-events: none;
    animation: headBlockPulse 3s ease-in-out infinite;
    will-change: transform, opacity;
  }

  /* -------------------------------------------------- */
  /*  Ambient glow (decorative, statyczny)               */
  /* -------------------------------------------------- */
  .hero__glow {
    position: absolute;
    top: 40%;
    left: 45%;
    transform: translate(-50%, -50%);
    width: min(50vw, 700px);
    height: min(35vh, 450px);
    background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.25), transparent 70%);
    filter: blur(80px);
    opacity: 0.6;
    pointer-events: none;
    z-index: 0;
  }


  /* -------------------------------------------------- */
  /*  Content wrapper                                    */
  /* -------------------------------------------------- */
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 52rem;
  }

  /* -------------------------------------------------- */
  /*  Badge pill                                         */
  /* -------------------------------------------------- */
  .hero__badge {
    position: relative;
    overflow: hidden;
    display: inline-block;
    padding: 0.375rem 1rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 9999px;
    line-height: 1.4;
    user-select: none;
  }

  .hero__badge::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(245, 158, 11, 0.08) 50%,
      transparent 100%
    );
    animation: shimmer 4s ease-in-out infinite;
  }

  /* -------------------------------------------------- */
  /*  H1                                                 */
  /* -------------------------------------------------- */
  .hero__title {
    margin-top: 1.5rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: clamp(2.375rem, 5vw + 1rem, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    max-width: 50rem;
    background: linear-gradient(
      90deg,
      var(--color-text-primary) 0%,
      var(--color-text-primary) 40%,
      var(--color-accent) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: fadeInUp 500ms ease-out forwards, titleGradient 10s ease-in-out 500ms infinite;
  }

  /* -------------------------------------------------- */
  /*  Sub headline                                       */
  /* -------------------------------------------------- */
  .hero__subtitle {
    margin-top: 1rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: clamp(1.25rem, 2vw + 0.5rem, 1.75rem); /* 20-28px */
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1.3;
  }

  /* -------------------------------------------------- */
  /*  Description                                        */
  /* -------------------------------------------------- */
  .hero__description {
    margin-top: 1.5rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: clamp(0.9375rem, 1vw + 0.5rem, 1.0625rem); /* 15-17px */
    color: var(--color-text-secondary);
    max-width: 37.5rem;
    line-height: 1.6;
  }

  /* -------------------------------------------------- */
  /*  CTA row                                            */
  /* -------------------------------------------------- */
  .hero__cta {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  /* -------------------------------------------------- */
  /*  Buttons (shared)                                   */
  /* -------------------------------------------------- */
  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .hero__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Primary */
  .hero__btn--primary {
    background-color: var(--color-accent);
    color: var(--color-bg-primary);
    border: 1px solid transparent;
  }
  .hero__btn--primary:hover {
    background-color: var(--color-accent-hover);
  }

  /* Secondary */
  .hero__btn--secondary {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-medium);
  }
  .hero__btn--secondary:hover {
    border-color: var(--color-accent);
  }

  /* -------------------------------------------------- */
  /*  Responsive — mobile                                */
  /* -------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .anim {
      opacity: 1;
      animation: none;
    }
    .hero__head-block {
      animation: none;
      opacity: 0.5;
      transform: translate(-50%, -50%) scale(1);
      box-shadow: 0 0 8px 2px rgba(245, 158, 11, 0.1);
    }
    .hero__badge::after { animation: none; }
    .hero__title {
      opacity: 1;
      animation: none;
      background-position: 0% center;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 80vh;
      padding: 4rem 1.25rem;
    }

    .hero::before {
      left: 8%;
    }

    .hero::after {
      background:
        radial-gradient(circle 5px at 8% 8%, rgba(245, 158, 11, 0.4) 40%, transparent 60%),
        radial-gradient(circle 5px at 8% 34%, rgba(245, 158, 11, 0.4) 40%, transparent 60%),
        radial-gradient(circle 5px at 8% 60%, rgba(245, 158, 11, 0.4) 40%, transparent 60%),
        radial-gradient(circle 8px at 8% 92%, rgba(245, 158, 11, 0.6) 40%, transparent 60%);
    }

    .hero__head-block {
      left: 8%;
    }

    .hero__glow {
      width: min(80vw, 350px);
      height: min(40vh, 250px);
      filter: blur(60px);
    }

    .hero__cta {
      flex-direction: column;
      width: 100%;
    }

    .hero__btn {
      width: 100%;
    }
  }
</style>
