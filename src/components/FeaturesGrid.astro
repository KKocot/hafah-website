---
const features = [
  {
    title: 'Pure SQL',
    desc: 'Business logic lives entirely in PostgreSQL functions using PL/pgSQL. No middleware layer, no ORM overhead — just direct SQL execution.',
  },
  {
    title: 'Zero Replay',
    desc: 'Deploy in minutes, not hours. HAFAh reads directly from HAF’s shared base tables, eliminating the need for costly data replay.',
  },
  {
    title: 'Dual API',
    desc: 'JSON-RPC 2.0 and REST endpoints served from a single deployment. One codebase, two protocols, zero duplication.',
  },
  {
    title: 'Smart Caching',
    desc: 'Irreversible blocks are cached for up to a year. Reversible data refreshes every 2 seconds. Smart headers let proxies and CDNs do the heavy lifting.',
  },
];
---

<section id="features" class="fp__section" aria-labelledby="fp-heading">
  <div class="fp__container">
    <header class="fp__header" data-fp-animate>
      <h2 id="fp-heading" class="fp__title">Built for Production</h2>
      <p class="fp__subtitle">
        Everything you need to run a Hive account history node
      </p>
    </header>

    {features.map((feature, index) => (
      <Fragment>
        <hr
          class="fp__divider"
          role="separator"
          aria-hidden="true"
          data-fp-animate
          data-fp-index={index}
        />
        <div class="fp__feature" data-fp-animate data-fp-index={index}>
          <h3 class="fp__name">{feature.title}</h3>
          <p class="fp__desc">{feature.desc}</p>
        </div>
      </Fragment>
    ))}
  </div>
</section>

<style>
  .fp__section {
    padding: 6rem 1.5rem;
  }

  .fp__container {
    max-width: 56.25rem;
    margin: 0 auto;
  }

  /* --- Header --- */
  .fp__header {
    text-align: center;
    margin-bottom: 3rem;
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 500ms ease-out,
      transform 500ms ease-out;
  }

  .fp__header.fp--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .fp__title {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .fp__subtitle {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 31.25rem;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* --- Divider --- */
  .fp__divider {
    border: none;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(245, 158, 11, 0.3) 20%,
      rgba(245, 158, 11, 0.15) 80%,
      transparent 100%
    );
    margin: 2rem 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms ease-out;
  }

  .fp__divider.fp--visible {
    transform: scaleX(1);
  }

  /* --- Feature --- */
  .fp__feature {
    padding: 0.5rem 0;
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 400ms ease-out,
      transform 400ms ease-out;
  }

  .fp__feature.fp--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .fp__name {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .fp__desc {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .fp__section {
      padding: 4rem 1.25rem;
    }

    .fp__divider {
      margin: 1.5rem 0;
    }
  }

  /* --- Reduced motion --- */
  @media (prefers-reduced-motion: reduce) {
    .fp__header,
    .fp__feature {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .fp__divider {
      transform: scaleX(1);
      transition: none;
    }
  }
</style>

<script>
  function initFeaturesProduction() {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const animatable =
      document.querySelectorAll<HTMLElement>('[data-fp-animate]');

    if (prefersReducedMotion) {
      animatable.forEach((el) => el.classList.add('fp--visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const revealed: HTMLElement[] = [];

        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            revealed.push(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });

        revealed.sort((a, b) => {
          const ai = parseInt(a.dataset.fpIndex ?? '-1', 10);
          const bi = parseInt(b.dataset.fpIndex ?? '-1', 10);
          return ai - bi;
        });

        revealed.forEach((el, i) => {
          setTimeout(() => {
            el.classList.add('fp--visible');
          }, i * 100);
        });
      },
      { threshold: 0.1 }
    );

    animatable.forEach((el) => observer.observe(el));
  }

  initFeaturesProduction();
  document.addEventListener('astro:after-swap', initFeaturesProduction);
</script>
